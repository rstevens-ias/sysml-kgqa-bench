# Copy to .env and fill in the credentials for the backend you use.

# --backend openai (benchmark verbalization)
OPENAI_API_KEY=

# --backend private: any OpenAI-compatible endpoint, e.g. a vLLM server (LLM baselines)
PRIVATE_API_KEY=
PRIVATE_ENDPOINT=

# Optional: Hugging Face token for downloading the embedding model
HF_TOKEN=
